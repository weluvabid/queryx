{
  "name": "@weluvabid/queryx",
  "version": "0.1.1",
  "description": "A fast, predictable query-string parser and serializer for JavaScript and TypeScript.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "bench": "npm run build && node benchmarks/run.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm run lint && npm run format:check && npm run test:unit",
    "precommit": "npm run check",
    "prepare": "sh ./scripts/install-hooks.sh",
    "test:unit": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.3",
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.48.1",
    "prettier": "^3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weluvabid/queryx.git"
  },
  "homepage": "https://github.com/weluvabid/queryx#readme",
  "bugs": {
    "url": "https://github.com/weluvabid/queryx/issues"
  },
  "keywords": [
    "query-string",
    "querystring",
    "url",
    "parser",
    "serializer",
    "typescript",
    "javascript",
    "urlsearchparams"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Abid"
}
